__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.DS_Store
out/
dist/

# Python build directories, at the repository root ONLY. A bare `build/` here
# also matched figures/build/, which silently untracked every generated figure
# in the course -- the build script says they are committed, the session
# READMEs link to them, and on GitHub those links were broken.
/build/

*.egg-info/
.venv/

# One-time MathJax download for tools/build_handouts.py.
tools/.cache/

# Problem-set masters contain solutions. This repository is public.
private/

# Assembled decks may embed copyrighted figures. Never commit them.
private/build/decks/

# Intermediate HTML from tools/build_handouts.py. The PDFs are the artifact.
handouts/build/

# Session scratch: files parked for deletion because the device shell cannot rm.
_to_delete/

# Working scratch from a build or review session. On 25 October this held 307
# PNGs, among them crops of published paper figures (scott2010_fig4.png,
# f4b.png) -- the same material private/paper-figures/ exists to keep out of a
# public repository. It was untracked rather than ignored, so a single
# `git add -A` would have published it.
_scratch/
